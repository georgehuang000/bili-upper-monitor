# ============================================================
# 复制成 .env 后填写：cp .env.example .env   （Windows: copy .env.example .env）
# .env 已被 .gitignore 排除，密钥不会被提交。
# ============================================================

# ───── LLM（用于生成字幕摘要与日报）─────
# 推荐做法：启动后打开网页 → 顶栏「模型设置」→ 选服务商 / 粘贴 API Key /
#           点「测试连接」→ 保存。配置会写回本文件并即时生效，无需重启。
LLM_API_KEY=
# 手动写在 .env 里的键名（与 LLM_API_KEY 等价，优先用 LLM_API_KEY）
deepseek_key=
LLM_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash = DeepSeek-V4.1-Flash：1M 上下文、支持图片识别、最便宜
LLM_MODEL=deepseek-flash
# 兜底模型：主模型不可用时自动改用。注意 deepseek-v4-pro 不支持图片识别
LLM_MODEL_FALLBACK=deepseek-v4-pro
# 图片识别专用模型；留空则跟随 LLM_MODEL
VISION_MODEL=
# 思考模式：disabled（默认，省时省钱）/ low / high / max
# DeepSeek 的思考模式默认开启且强度为 high，对「把字幕压成摘要」这类任务又慢又贵
LLM_THINKING=disabled

# ───── 图片识别（读封面/配图，把画面文字喂给日报）─────
# 实测：B站 feed 里的动态配图多数拿不到（充电专属会被剥离成 MAJOR_TYPE_BLOCKED，
# 纯文字贴本来就没图），所以这一项实际主要作用在「视频封面」上。
# 需要服务商支持读图：DeepSeek 官方只有 deepseek-flash 支持。
VISION_ENABLED=true
# 每轮最多识别几张图（0 = 关闭）。图片本身很便宜（单图最多约 1024 tokens），
# 但调用是串行的，配额用来兜住一轮的总耗时。
VISION_MAX_IMAGES_PER_ROUND=20
# 只处理最近 N 天内「还没识别过」的内容，不回头重刷历史
VISION_LOOKBACK_DAYS=7
# detail 档位：留空 = 不发送该参数（非 DeepSeek 的网关不保证认这个字段）
# DeepSeek 官方会自动用 low（长边压到 512px，省 token）
VISION_DETAIL=

# ───── 订阅的 UP 主（UID，逗号分隔；网页端也能增删）─────
# 网页端「搜索/订阅」写入数据库，这里只是初始种子
UP_UIDS=

# ───── 爬取策略 ─────
# true = 纯 API 模式（httpx + WBI 签名），服务器上唯一可用方式
USE_PURE_API=true
# 每轮爬取中相邻 UID 的请求间隔秒数；风控频繁时调大（默认 12/20）
CRAWL_SLEEP_MIN=12
CRAWL_SLEEP_MAX=20
# 启动时是否立刻跑一轮「爬取 + 总结」，默认 false
AUTO_CRAWL_ON_START=false
# 定时任务时间（24 小时制）
CRAWL_MORNING=08:00
CRAWL_EVENING=18:00
# 日志级别：INFO / DEBUG
LOG_LEVEL=INFO

# ───── B站登录态（纯 API 爬取必需）─────
# 最省事：启动后打开网页点顶栏「扫码登录」，用 B站 App 扫码，
#         登录态会自动写回本文件并即时生效，无需重启。
# 手动方式：浏览器 F12 → Application → Cookies → bilibili.com 复制。
# 注意：SESSDATA 失效后空间接口会返回 -352（看起来像风控，其实是没登录）。
BILI_SESSDATA=
# bili_jct 仅写操作（发评论/点赞）需要，只读爬取可不配
BILI_JCT=
BILI_BUVID3=
BILI_BUVID4=
BILI_DEDEUSERID=

# ───── 可选：长度上限（默认值已够用，需要时取消注释）─────
# SUBTITLE_MAX_CHARS=200000
# SUMMARY_VIDEO_INPUT_MAX_CHARS=80000
# SUMMARY_INPUT_MAX_CHARS=16000