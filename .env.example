# ============================================================
# 复制成 .env 后填写：cp .env.example .env   （Windows: copy .env.example .env）
# .env 已被 .gitignore 排除，密钥不会被提交。
# ============================================================

# ───── LLM（用于生成字幕摘要与日报）─────
sensetime_key=
# 若 key 与文档站点绑定，可填对应文档标识；不需要则留空
sensetime_doc=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_FALLBACK=

# ───── 订阅的 UP 主（UID，逗号分隔；网页端也能增删）─────
# 网页端「搜索/订阅」写入数据库，这里只是初始种子
UP_UIDS=

# ───── 爬取策略 ─────
# true = 纯 API 模式（httpx + WBI 签名），服务器上唯一可用方式
USE_PURE_API=true
# 每轮爬取中相邻 UID 的请求间隔秒数；风控频繁时调大（默认 12/20）
CRAWL_SLEEP_MIN=12
CRAWL_SLEEP_MAX=20
# 启动时是否立刻跑一轮「爬取 + 总结」，默认 false
AUTO_CRAWL_ON_START=false
# 定时任务时间（24 小时制）
CRAWL_MORNING=08:00
CRAWL_EVENING=18:00
# 日志级别：INFO / DEBUG
LOG_LEVEL=INFO

# ───── B站登录态（纯 API 爬取必需）─────
# 最省事：启动后打开网页点顶栏「扫码登录」，用 B站 App 扫码，
#         登录态会自动写回本文件并即时生效，无需重启。
# 手动方式：浏览器 F12 → Application → Cookies → bilibili.com 复制。
# 注意：SESSDATA 失效后空间接口会返回 -352（看起来像风控，其实是没登录）。
BILI_SESSDATA=
# bili_jct 仅写操作（发评论/点赞）需要，只读爬取可不配
BILI_JCT=
BILI_BUVID3=
BILI_BUVID4=
BILI_DEDEUSERID=

# ───── 可选：长度上限（默认值已够用，需要时取消注释）─────
# SUBTITLE_MAX_CHARS=200000
# SUMMARY_VIDEO_INPUT_MAX_CHARS=80000
# SUMMARY_INPUT_MAX_CHARS=16000